eav_f2="\xff\x00\x00\xd0"
vbl_1="\xff\x00\x00\xa0"
vbl_2="\xff\x00\x00\xb0"
vbl_3="\xff\x00\x00\xe0"
vbl_4="\xff\x00\x00\xf0"
# ancillary-data header, DID 0xbf
anc="\x00\xff\xff\xbf"
anc_hdr="\x00\xff\xff\xbf\x00\x0f"
